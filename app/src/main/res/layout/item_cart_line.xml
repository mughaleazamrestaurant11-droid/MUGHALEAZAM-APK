<?xml version="1.0" encoding="utf-8"?>
<!-- One line already on the bill. The waiter can add or take away here;
     a line the kitchen already has shows it, so nobody eats the cost. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lineName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lineMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_dim"
            android:textSize="10sp" />

        <!-- the till's own sentence when food comes back off a bill the
             kitchen already knows about - the ticket prints a minus, so the
             cooks are told to take it away instead of it vanishing -->
        <TextView
            android:id="@+id/lineNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/red"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/lineMinus"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/card"
        android:gravity="center"
        android:text="−"
        android:textColor="@color/text"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/lineQty"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/gold"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/linePlus"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/card"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/text"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/lineRemove"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/card"
        android:gravity="center"
        android:text="✕"
        android:textColor="@color/red"
        android:textSize="15sp" />
</LinearLayout>
