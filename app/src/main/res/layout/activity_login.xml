<?xml version="1.0" encoding="utf-8"?>
<!-- 2. Who is holding this phone. The password is checked by the MAIN
     SERVER, never here - this screen only asks and repeats the answer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="26dp">

    <ImageView
        android:id="@+id/loginLogo"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_launcher" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.16"
        android:text="@string/app_name"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/login_title"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/loginUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:background="@drawable/field"
        android:hint="@string/login_user"
        android:importantForAutofill="no"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/text_dim"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/loginPass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/field"
        android:hint="@string/login_pass"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/text_dim"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/loginGo"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:text="@string/login_go"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/loginBusy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:indeterminateTint="@color/gold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/loginStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/red"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/loginServer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/loginAgain"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/login_again"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />
</LinearLayout>
