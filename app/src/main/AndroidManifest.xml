<?xml version="1.0" encoding="utf-8"?>
<!--
  Round 25 - the waiter app.

  It is a window onto the MAIN SERVER, not a second till.  It needs the
  internet permission to talk to that server over the wi-fi and nothing else
  that could reach outside the shop: no camera, no contacts, no location, no
  storage.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".PosApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MughalPos"
        android:usesCleartextTraffic="true">

        <!-- 1. which main server this phone belongs to -->
        <activity
            android:name=".ui.ServerActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. who is holding the phone -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 3. which table is being served -->
        <activity
            android:name=".ui.TablesActivity"
            android:exported="false" />

        <!-- 4. the order itself -->
        <activity
            android:name=".ui.OrderActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
